{
  "components" : {
    "schemas" : {
      "Account" : {
        "properties" : {
          "currency" : {
            "example" : "RON",
            "type" : "string"
          },
          "ibanMasked" : {
            "description" : "e.g. RO49 •••• 0000; absent when the IBAN is unknown",
            "type" : "string"
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "kind" : {
            "enum" : [ "CURRENT", "SAVINGS", "CARD" ],
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "currency", "id", "kind", "name" ],
        "type" : "object"
      },
      "AccountImport" : {
        "properties" : {
          "account" : {
            "$ref" : "#/components/schemas/Account"
          },
          "alreadyImported" : {
            "format" : "int32",
            "type" : "integer"
          },
          "created" : {
            "description" : "Detected for the first time by this upload",
            "type" : "boolean"
          },
          "newTransactions" : {
            "format" : "int32",
            "type" : "integer"
          },
          "periodFrom" : {
            "format" : "date",
            "type" : "string"
          },
          "periodTo" : {
            "format" : "date",
            "type" : "string"
          }
        },
        "required" : [ "account", "alreadyImported", "created", "newTransactions" ],
        "type" : "object"
      },
      "AliasResult" : {
        "properties" : {
          "movedTransactions" : {
            "format" : "int32",
            "type" : "integer"
          },
          "recategorizedTransactions" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "movedTransactions", "recategorizedTransactions" ],
        "type" : "object"
      },
      "Category" : {
        "properties" : {
          "code" : {
            "example" : "GROCERIES",
            "type" : "string"
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "kind" : {
            "description" : "Only SPEND counts towards spent",
            "enum" : [ "SPEND", "INCOME", "TRANSFER" ],
            "type" : "string"
          },
          "name" : {
            "example" : "Groceries",
            "type" : "string"
          },
          "parentId" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "code", "id", "kind", "name" ],
        "type" : "object"
      },
      "CategoryChange" : {
        "properties" : {
          "changedTransactions" : {
            "description" : "Transactions whose category changed, this one included",
            "format" : "int32",
            "type" : "integer"
          },
          "transaction" : {
            "$ref" : "#/components/schemas/TransactionView"
          }
        },
        "required" : [ "changedTransactions", "transaction" ],
        "type" : "object"
      },
      "CategorySpend" : {
        "properties" : {
          "categoryId" : {
            "format" : "int64",
            "type" : "integer"
          },
          "code" : {
            "type" : "string"
          },
          "deltaPct" : {
            "description" : "vs. usual; absent when there is no usual to compare with",
            "format" : "int32",
            "type" : "integer"
          },
          "name" : {
            "type" : "string"
          },
          "sharePct" : {
            "description" : "Of the month's spent",
            "format" : "int32",
            "type" : "integer"
          },
          "spentMinor" : {
            "format" : "int64",
            "type" : "integer"
          },
          "transactionCount" : {
            "format" : "int32",
            "type" : "integer"
          },
          "usualMinor" : {
            "description" : "Average over the baseline months",
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "name", "sharePct", "spentMinor", "transactionCount", "usualMinor" ],
        "type" : "object"
      },
      "Explanation" : {
        "properties" : {
          "categoryCode" : {
            "type" : "string"
          },
          "categorySource" : {
            "description" : "Which tier would categorize it: RULE, LEARNED or KEYWORD; absent when none",
            "type" : "string"
          },
          "key" : {
            "type" : "string"
          },
          "steps" : {
            "items" : {
              "$ref" : "#/components/schemas/Step"
            },
            "type" : "array"
          }
        },
        "required" : [ "key", "steps" ],
        "type" : "object"
      },
      "FileOutcome" : {
        "properties" : {
          "accountId" : {
            "format" : "int64",
            "type" : "integer"
          },
          "alreadyImported" : {
            "description" : "Rows already imported by an earlier file",
            "format" : "int32",
            "type" : "integer"
          },
          "candidates" : {
            "description" : "Parser scores, best first; filled when the user has to pick (NEEDS_PARSER)",
            "items" : {
              "$ref" : "#/components/schemas/ParserCandidate"
            },
            "type" : "array"
          },
          "fileName" : {
            "type" : "string"
          },
          "message" : {
            "description" : "Why the file was not imported, in words for the user",
            "type" : "string"
          },
          "newTransactions" : {
            "format" : "int32",
            "type" : "integer"
          },
          "parserId" : {
            "type" : "string"
          },
          "periodFrom" : {
            "format" : "date",
            "type" : "string"
          },
          "periodTo" : {
            "format" : "date",
            "type" : "string"
          },
          "rows" : {
            "format" : "int32",
            "type" : "integer"
          },
          "status" : {
            "enum" : [ "IMPORTED", "DUPLICATE_FILE", "NEEDS_PARSER", "NEEDS_ACCOUNT", "FAILED" ],
            "type" : "string"
          }
        },
        "required" : [ "alreadyImported", "candidates", "fileName", "newTransactions", "rows", "status" ],
        "type" : "object"
      },
      "HealthResponse" : {
        "properties" : {
          "database" : {
            "enum" : [ "UP", "DOWN" ],
            "type" : "string"
          },
          "schemaVersion" : {
            "description" : "Applied Flyway version; absent when the database is down",
            "type" : "string"
          },
          "status" : {
            "enum" : [ "UP", "DOWN" ],
            "type" : "string"
          }
        },
        "required" : [ "database", "status" ],
        "type" : "object"
      },
      "ImportSummary" : {
        "properties" : {
          "accounts" : {
            "items" : {
              "$ref" : "#/components/schemas/AccountImport"
            },
            "type" : "array"
          },
          "alreadyImported" : {
            "format" : "int32",
            "type" : "integer"
          },
          "files" : {
            "items" : {
              "$ref" : "#/components/schemas/FileOutcome"
            },
            "type" : "array"
          },
          "newTransactions" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "accounts", "alreadyImported", "files", "newTransactions" ],
        "type" : "object"
      },
      "MerchantSummary" : {
        "properties" : {
          "categoryCode" : {
            "type" : "string"
          },
          "displayName" : {
            "type" : "string"
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "key" : {
            "type" : "string"
          },
          "sampleDescriptions" : {
            "description" : "Up to 3 distinct raw descriptions, IBANs masked",
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "transactionCount" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "displayName", "id", "key", "sampleDescriptions", "transactionCount" ],
        "type" : "object"
      },
      "MonthSummary" : {
        "properties" : {
          "accuracyPct" : {
            "description" : "Share of this month's spending to trust: weighted by category confidence",
            "format" : "int32",
            "type" : "integer"
          },
          "availableMonths" : {
            "description" : "Months with data, oldest first, e.g. 2026-01",
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "averageSpentMinor" : {
            "description" : "Average spent over the baseline months; absent without history",
            "format" : "int64",
            "type" : "integer"
          },
          "baselineMonths" : {
            "description" : "How many of the previous 3 months have data; the average uses only those",
            "format" : "int32",
            "type" : "integer"
          },
          "categories" : {
            "description" : "Top 5 by spent, largest first",
            "items" : {
              "$ref" : "#/components/schemas/CategorySpend"
            },
            "type" : "array"
          },
          "categorizedPct" : {
            "description" : "Share of this month's spending with any category",
            "format" : "int32",
            "type" : "integer"
          },
          "currency" : {
            "example" : "RON",
            "type" : "string"
          },
          "deltaPct" : {
            "description" : "Spent vs. that average, e.g. 12 for +12%; absent without history or when it is 0",
            "format" : "int32",
            "type" : "integer"
          },
          "incomeMinor" : {
            "format" : "int64",
            "type" : "integer"
          },
          "month" : {
            "example" : "2026-03",
            "type" : "string"
          },
          "netMinor" : {
            "description" : "Income − spent; negative when spending more",
            "format" : "int64",
            "type" : "integer"
          },
          "rest" : {
            "$ref" : "#/components/schemas/Rest",
            "description" : "Everything below the top 5, folded"
          },
          "spentMinor" : {
            "format" : "int64",
            "type" : "integer"
          },
          "uncategorizedCount" : {
            "format" : "int32",
            "type" : "integer"
          },
          "uncategorizedMinor" : {
            "description" : "Spent without a category, wherever it ranks (it may be folded into the rest)",
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "accuracyPct", "availableMonths", "baselineMonths", "categories", "categorizedPct", "currency", "incomeMinor", "month", "netMinor", "rest", "spentMinor", "uncategorizedCount", "uncategorizedMinor" ],
        "type" : "object"
      },
      "NewAccount" : {
        "properties" : {
          "currency" : {
            "example" : "RON",
            "type" : "string"
          },
          "kind" : {
            "enum" : [ "CURRENT", "SAVINGS", "CARD" ],
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "currency", "kind", "name" ],
        "type" : "object"
      },
      "NewAlias" : {
        "properties" : {
          "matchType" : {
            "enum" : [ "EXACT", "PREFIX" ],
            "type" : "string"
          },
          "merchantKey" : {
            "type" : "string"
          },
          "pattern" : {
            "description" : "Matched against the merchant key",
            "type" : "string"
          }
        },
        "required" : [ "matchType", "merchantKey", "pattern" ],
        "type" : "object"
      },
      "ParserCandidate" : {
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "parserId" : {
            "type" : "string"
          },
          "reason" : {
            "type" : "string"
          },
          "score" : {
            "description" : "0..1",
            "format" : "double",
            "type" : "number"
          }
        },
        "required" : [ "name", "parserId", "reason", "score" ],
        "type" : "object"
      },
      "Rest" : {
        "properties" : {
          "categoryCount" : {
            "format" : "int32",
            "type" : "integer"
          },
          "sharePct" : {
            "format" : "int32",
            "type" : "integer"
          },
          "spentMinor" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "categoryCount", "sharePct", "spentMinor" ],
        "type" : "object"
      },
      "SetCategory" : {
        "properties" : {
          "applyToMerchant" : {
            "description" : "Answer to 'apply to this merchant from now on?': creates a rule for the merchant",
            "type" : "boolean"
          },
          "categoryId" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "categoryId" ],
        "type" : "object"
      },
      "Step" : {
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "output" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "TransactionView" : {
        "properties" : {
          "accountId" : {
            "format" : "int64",
            "type" : "integer"
          },
          "amountMinor" : {
            "description" : "Signed minor units; negative = money out",
            "format" : "int64",
            "type" : "integer"
          },
          "bookingDate" : {
            "format" : "date",
            "type" : "string"
          },
          "categoryCode" : {
            "type" : "string"
          },
          "categoryConfidence" : {
            "type" : "number"
          },
          "categoryId" : {
            "format" : "int64",
            "type" : "integer"
          },
          "categorySource" : {
            "description" : "USER, RULE, LEARNED, MCC, KEYWORD, SYSTEM; absent when uncategorized",
            "type" : "string"
          },
          "currency" : {
            "example" : "RON",
            "type" : "string"
          },
          "description" : {
            "description" : "Bank text with IBANs masked",
            "type" : "string"
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "merchantKey" : {
            "type" : "string"
          },
          "merchantName" : {
            "type" : "string"
          }
        },
        "required" : [ "accountId", "amountMinor", "bookingDate", "currency", "description", "id", "merchantKey", "merchantName" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "title" : "Outflow API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/accounts" : {
      "get" : {
        "operationId" : "list",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/Account"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "accounts" ]
      },
      "post" : {
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/NewAccount"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Account"
                }
              }
            },
            "description" : "Created"
          }
        },
        "tags" : [ "accounts" ]
      }
    },
    "/api/categories" : {
      "get" : {
        "operationId" : "list_2",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/Category"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "categories" ]
      }
    },
    "/api/health" : {
      "get" : {
        "operationId" : "health",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "system" ]
      }
    },
    "/api/imports" : {
      "post" : {
        "operationId" : "importFiles",
        "parameters" : [ {
          "description" : "Account for files that do not name one (no IBAN)",
          "in" : "query",
          "name" : "accountId",
          "required" : false,
          "schema" : {
            "format" : "int64",
            "type" : "integer"
          }
        }, {
          "description" : "Force a parser instead of detection, e.g. after NEEDS_PARSER",
          "in" : "query",
          "name" : "parserId",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "properties" : {
                  "files" : {
                    "items" : {
                      "format" : "binary",
                      "type" : "string"
                    },
                    "type" : "array"
                  }
                },
                "required" : [ "files" ],
                "type" : "object"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ImportSummary"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "imports" ]
      }
    },
    "/api/insights/month" : {
      "get" : {
        "operationId" : "month",
        "parameters" : [ {
          "description" : "YYYY-MM; defaults to the latest month with data",
          "in" : "query",
          "name" : "month",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "ISO currency; v1 reports one currency at a time",
          "in" : "query",
          "name" : "currency",
          "required" : false,
          "schema" : {
            "default" : "RON",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MonthSummary"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "insights" ]
      }
    },
    "/api/merchants" : {
      "get" : {
        "operationId" : "list_1",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/MerchantSummary"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "merchants" ]
      }
    },
    "/api/merchants/aliases" : {
      "post" : {
        "operationId" : "addAlias",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/NewAlias"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AliasResult"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "merchants" ]
      }
    },
    "/api/merchants/explain" : {
      "get" : {
        "operationId" : "explain",
        "parameters" : [ {
          "in" : "query",
          "name" : "raw",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Explanation"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "merchants" ]
      }
    },
    "/api/transactions/{id}/category" : {
      "delete" : {
        "operationId" : "clear",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "int64",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CategoryChange"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "categories" ]
      },
      "put" : {
        "operationId" : "set",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "int64",
            "type" : "integer"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SetCategory"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CategoryChange"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "categories" ]
      }
    }
  },
  "servers" : [ {
    "url" : "/"
  } ]
}
